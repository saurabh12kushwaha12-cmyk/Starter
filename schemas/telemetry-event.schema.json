{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "eventId",
    "traceId",
    "sessionId",
    "timestamp",
    "eventType",
    "component",
    "status"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "eventType": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "failure",
        "pending",
        "denied"
      ]
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}