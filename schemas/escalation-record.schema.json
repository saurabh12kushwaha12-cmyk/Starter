{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "escalationId",
    "traceId",
    "requestSummary",
    "completedSteps",
    "reason",
    "recommendedNextStep"
  ],
  "properties": {
    "escalationId": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "customerId": {
      "type": "string"
    },
    "requestSummary": {
      "type": "string"
    },
    "completedSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "recommendedNextStep": {
      "type": "string"
    }
  },
  "additionalProperties": true
}