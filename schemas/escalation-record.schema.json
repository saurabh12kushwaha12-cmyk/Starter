{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise CX escalation record",
  "type": "object",
  "required": [
    "escalationId",
    "traceId",
    "requestSummary",
    "verifiedContext",
    "completedSteps",
    "enterpriseSystemsAccessed",
    "evidence",
    "failedTools",
    "errorSummary",
    "reason",
    "pendingAction",
    "recommendedNextStep",
    "createdAt"
  ],
  "properties": {
    "escalationId": {
      "type": "string",
      "pattern": "^ESC-[A-F0-9]{10}$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^TRACE-[A-F0-9]{12}$"
    },
    "customerId": {
      "type": ["string", "null"]
    },
    "requestSummary": {
      "type": "string",
      "maxLength": 300
    },
    "verifiedContext": {
      "type": "object",
      "required": ["customerId", "authenticatedSession"],
      "properties": {
        "customerId": {
          "type": ["string", "null"]
        },
        "authenticatedSession": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "completedSteps": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 30
    },
    "enterpriseSystemsAccessed": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 20
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": {"type": ["string", "null"]},
          "eventType": {"type": "string"},
          "component": {"type": ["string", "null"]},
          "status": {"type": ["string", "null"]},
          "metadata": {"type": "object"}
        },
        "additionalProperties": true
      },
      "maxItems": 30
    },
    "failedTools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "eventType", "status", "metadata"],
        "properties": {
          "component": {"type": "string"},
          "eventType": {"type": "string"},
          "status": {"type": "string"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "errorSummary": {
      "type": "string",
      "maxLength": 240
    },
    "reason": {
      "type": "string",
      "maxLength": 240
    },
    "pendingAction": {
      "type": ["object", "null"],
      "properties": {
        "type": {"type": "string"},
        "accountId": {"type": ["string", "null"]},
        "keyFingerprint": {"type": ["string", "null"]},
        "summary": {"type": ["string", "null"]},
        "executionOutcome": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "recommendedNextStep": {
      "type": "string",
      "maxLength": 240
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
